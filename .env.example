# Copy to .env (and load it however your shell/CLI prefers, or pass these
# as the "env" block in your MCP client config instead).

POE2_GGG_CLIENT_ID=
POE2_CONTACT_EMAIL=

# Optional overrides -- only set these if auto-detection doesn't find things:
# POE2_CLIENT_LOG_PATH=/path/to/Path of Exile 2/logs/Client.txt
# POE2_REDIRECT_PORT=8730
# POE2_CONFIG_DIR=~/.config/poe2-mcp-server
