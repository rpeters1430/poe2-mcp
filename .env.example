# Copy to .env (and load it however your shell/CLI prefers, or pass these
# as the "env" block in your MCP client config instead).

POE2_GGG_CLIENT_ID=
POE2_CONTACT_EMAIL=

# Optional overrides -- only set these if auto-detection doesn't find things:
# POE2_CLIENT_LOG_PATH=/path/to/Path of Exile 2/logs/Client.txt
# POE2_REDIRECT_PORT=8730
# POE2_MCP_CONFIG_DIR=~/.config/poe2-mcp-server
# POE2_ACCOUNT_NAME=rpeters1428-1042
# POE2_POB_BUILDS_PATH=/path/to/Path of Building (PoE2)/Builds
# POE2_TREE_DATA_URL=https://raw.githubusercontent.com/grindinggear/poe2-skilltree-export/master/data.json

# Optional: only if the official trade site rejects unauthenticated searches.
# Keep this secret out of chat, logs, examples, and version control.
# POE2_TRADE_POESESSID=

# Optional: only used by `npm run serve` / the Docker image (src/serve.ts),
# the network-reachable counterpart to the stdio-only index.ts -- see
# README.md's "Remote access" section.
# POE2_SERVE_PORT=8787
# Shared-secret gate for /api, /ws, and /mcp when serve.ts is reachable
# beyond localhost (e.g. from your laptop over the LAN). Strongly
# recommended once you're not just testing on the same machine.
# POE2_WEB_TOKEN=
# Where src/clipboard-watcher.ts (desktop-only, Windows) should POST
# detected item text -- point it at the desktop's own serve.ts, so this is
# almost always localhost even when the dashboard is viewed remotely.
# POE2_SERVE_URL=http://127.0.0.1:8787
